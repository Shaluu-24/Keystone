            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Capacitor 5uF\",\n  \"sku\": \"ELEC-CAP-005\",\n  \"unitCost\": 4.50,\n  \"stockQty\": 100\n}"
            },
            "url": {
