      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/reports/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "summary"]
            },
            "description": "MANAGER/DISPATCHER only. Returns counts by status, overdue count, SLA compliance %."
          },
          "response": [
            {
              "name": "200 OK - Sample Response",
              "originalRequest": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/reports/summary" } },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"countsByStatus\": {\n    \"NEW\": 3,\n    \"ASSIGNED\": 2,\n    \"IN_PROGRESS\": 1,\n    \"ON_HOLD\": 0,\n    \"COMPLETED\": 4,\n    \"CLOSED\": 5,\n    \"CANCELLED\": 0\n  },\n  \"overdueCount\": 1,\n  \"closedCount\": 5,\n  \"slaMetCount\": 4,\n  \"slaCompliancePct\": 80.0\n}"
            }
          ]
        }
      ]
    }
  ]
}
